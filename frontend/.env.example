# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ─── Backend API URL ──────────────────────────────────────────────────────────
# VITE_API_URL is REQUIRED for production builds. Vite inlines it at BUILD time,
# so changing it on a hosting provider requires a REDEPLOY — restarting the
# service is not enough, and it must be set as a BUILD-time variable.
#
# There is no production fallback host in src/config/api.js: a production build
# with this unset throws on startup rather than silently calling a dead server.
#
# VITE_API_URL=https://dashboard-api.your-domain.com

# ─── Local dev only ───────────────────────────────────────────────────────────
# VITE_DB_MODE picks a local backend when VITE_API_URL is not set. It has NO
# effect on production builds.
#   "demo"  → http://localhost:2000  (in-memory, no DB needed)
#   "local" → http://localhost:2000  (real MySQL locally)
VITE_DB_MODE=demo
# VITE_DB_MODE=local
